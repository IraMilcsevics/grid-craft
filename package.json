{
  "name": "gridcraft",
  "private": true,
  "version": "0.1.0",
  "description": "An advanced data grid with virtualized rows, validation, inline editing and CSV import, built with React and TanStack Table.",
  "license": "MIT",
  "homepage": "https://iramilcsevics.github.io/grid-craft/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IraMilcsevics/grid-craft.git"
  },
  "bugs": {
    "url": "https://github.com/IraMilcsevics/grid-craft/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "tanstack-table",
    "tanstack-virtual",
    "data-grid",
    "csv",
    "virtual-scrolling"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "bench:domain": "tsx scripts/bench-domain.ts",
    "bench:browser": "node scripts/bench-browser.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.88.0",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
